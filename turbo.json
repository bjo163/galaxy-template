{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"] },
    "lint": {},
    "lint:fix": { "cache": false },
    "typecheck": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true },
    "start": { "cache": false },
    "clean": { "cache": false }
  }
}
