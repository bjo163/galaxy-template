{
  "name": "arsy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "pnpm --filter @galaxy/database build",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs watch --exclude \"**/node_modules/.vite-temp/**\" src/server.ts",
    "prebuild": "pnpm --filter @galaxy/database build",
    "build": "pnpm build:server && pnpm build:console",
    "build:server": "tsc -p tsconfig.build.json",
    "build:console": "vite build",
    "pretest": "pnpm --filter @galaxy/database build",
    "prestart": "pnpm --filter @galaxy/database build",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/cli/migrations.js up",
    "db:rollback": "pnpm build && node --env-file-if-exists=../../.env dist/cli/migrations.js down",
    "db:status": "pnpm build && node --env-file-if-exists=../../.env dist/cli/migrations.js status",
    "db:provision-roles": "pnpm build && node --env-file-if-exists=../../.env dist/cli/postgres-roles.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"console/src/**/*.test.ts\"",
    "pretypecheck": "pnpm --filter @galaxy/database build",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:console",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:console": "tsc --noEmit -p tsconfig.console.json"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "5.2.6",
    "@fastify/vite": "10.0.0",
    "@galaxy/database": "workspace:*",
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.8",
    "nodemailer": "^10.3.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@galaxy/tsconfig": "workspace:^",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
