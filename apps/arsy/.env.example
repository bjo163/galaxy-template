NODE_ENV=development
DATABASE_ADAPTER=pglite
PGLITE_DATA_DIR=./data/arsy
# ARSY_POSTGRES_ADMIN_URL=
# ARSY_MIGRATOR_PASSWORD=
# ARSY_RUNTIME_PASSWORD=
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/arsy
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3001
# Configure a local SMTP catcher such as Mailpit to deliver account emails.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=notifications@localhost
# SMTP_USER=
# SMTP_PASSWORD=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
OPENAPI_ENABLED=false
METRICS_ENABLED=false
METRICS_TOKEN=
