{
  "name": "galaxy-monorepo",
  "version": "5.0.1",
  "license": "Commercial",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm db:up:dev && pnpm db:migrate:arsy && node .scripts/load-env.mjs . node_modules/turbo/bin/turbo run dev --env-mode=loose",
    "dev:arsy": "pnpm db:up:dev && pnpm db:migrate:arsy && pnpm --filter arsy dev",
    "db:up:dev": "node .scripts/load-env.mjs . docker compose -f docker-compose.dev.yml up -d --wait",
    "build": "turbo run build",
    "build:arsy": "pnpm --filter arsy build",
    "build:database": "pnpm --filter @galaxy/database build",
    "start": "turbo run start",
    "start:arsy": "pnpm --filter arsy start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test:arsy": "pnpm --filter arsy test",
    "test:database": "pnpm --filter @galaxy/database test",
    "db:migrate:arsy": "pnpm --filter arsy db:migrate",
    "db:rollback:arsy": "pnpm --filter arsy db:rollback",
    "db:status:arsy": "pnpm --filter arsy db:status",
    "typecheck:arsy": "pnpm --filter arsy typecheck",
    "typecheck:database": "pnpm --filter @galaxy/database typecheck",
    "format": "pnpm --filter web format",
    "build:icons": "pnpm --filter web build:icons",
    "migrate": "pnpm --filter web migrate",
    "removeI18n": "pnpm --filter web removeI18n",
    "clean": "turbo run clean",
    "clear": "rimraf -g **/node_modules **/.next node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "rimraf": "5.0.7"
  },
  "pnpm": {
    "overrides": {
      "rimraf": "5.0.7",
      "unicorn-magic": "0.1.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "eslint": "8.57.1",
      "eslint-config-next": "15.1.2",
      "@emoji-mart/react>react": "19.2.3"
    }
  }
}
