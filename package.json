{
  "name": "galaxy-monorepo",
  "version": "5.0.1",
  "license": "Commercial",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "pnpm --filter web format",
    "build:icons": "pnpm --filter web build:icons",
    "migrate": "pnpm --filter web migrate",
    "removeI18n": "pnpm --filter web removeI18n",
    "clean": "turbo run clean",
    "clear": "rimraf -g **/node_modules **/.next node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "rimraf": "5.0.7"
  },
  "pnpm": {
    "overrides": {
      "rimraf": "5.0.7",
      "unicorn-magic": "0.1.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "eslint": "8.57.1",
      "eslint-config-next": "15.1.2",
      "@emoji-mart/react>react": "19.2.3"
    }
  }
}
