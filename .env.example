# Shared local development environment. Copy to .env.development at the repository root.

# Web app
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/vuexy-nextjs-admin-template/documentation
NEXTAUTH_BASEPATH=/api/auth
NEXTAUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_SECRET=galaxy-local-development-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MAPBOX_ACCESS_TOKEN=

# Arsy API and local PostgreSQL
NODE_ENV=development
DATABASE_ADAPTER=postgres
DATABASE_URL=postgresql://galaxy:galaxy-local-dev@localhost:5432/arsy
POSTGRES_DB=arsy
POSTGRES_USER=galaxy
POSTGRES_PASSWORD=galaxy-local-dev
HOST=0.0.0.0
ARSY_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CREATE_TIMEOUT_MS=30000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
OPENAPI_ENABLED=false
METRICS_ENABLED=false
METRICS_TOKEN=

# Arsy authentication API origin (omit /api/v1)
ARSY_API_URL=http://localhost:3001

# Production deployment: use distinct runtime and migrator database URLs.
# ARSY_RUNTIME_DATABASE_URL=postgresql://arsy_runtime:...@db:5432/arsy
# ARSY_MIGRATOR_DATABASE_URL=postgresql://arsy_migrator:...@db:5432/arsy
# The API uses DATABASE_URL/arsy_runtime; the lifecycle worker uses ARSY_MIGRATOR_DATABASE_URL.

# Optional production PostgreSQL role provisioning; keep real credentials in your local .env only.
# ARSY_POSTGRES_ADMIN_URL=
# ARSY_MIGRATOR_PASSWORD=
# ARSY_RUNTIME_PASSWORD=
